rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /workspaces/{workspace}/users/{uid}/checks/{file} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if owner();
      allow create: if owner() && resource == null && file.matches('.*[.]txt')
        && request.resource.size <= 1024
        && request.resource.contentType == 'text/plain';
    }
  }
}
