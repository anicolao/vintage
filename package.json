{
  "name": "vintage",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "npm run setup:hooks",
    "setup:hooks": "git config core.hooksPath .githooks",
    "check:prompts": "node scripts/check-prompts.mjs",
    "test:hooks": "node --test tests/hooks/prompts.test.mjs",
    "dev": "vite dev --host 127.0.0.1 --port 5195 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4195 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "firebase emulators:exec --project demo-vintage --only auth,firestore,storage \"node --test tests/rules/*.test.mjs && playwright test\"",
    "test:e2e:update-snapshots": "firebase emulators:exec --project demo-vintage --only auth,firestore,storage \"node --test tests/rules/*.test.mjs && playwright test --update-snapshots\"",
    "test:config": "node --test tests/config/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-vintage --only firestore,storage \"node --test tests/rules/*.test.mjs\"",
    "build:e2e": "vite build --mode e2e",
    "test:foundation": "npm run test:e2e",
    "build:live": "node scripts/build-live.mjs",
    "test:domain": "node --test tests/domain/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "firebase": "^12.18.0",
    "heic2any": "^0.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "firebase-tools": "^15.28.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
