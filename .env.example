# Copy to .env.local and fill with your Firebase web-app configuration.
# These VITE values are public client configuration, not admin credentials.
VITE_USE_FIREBASE_EMULATORS=false
VITE_E2E=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_WORKSPACE=pr-3
VITE_BUILD_REVISION=local
